# Copy this file to ".env" (same folder) and fill it in. Never commit ".env".

# MongoDB Atlas connection string (free M0 cluster), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Name of the database inside the cluster.
MONGODB_DB=starboy

# Optional. Set this if the health check says it can't reach the database on a
# phone hotspot or home router (their DNS often can't find an Atlas cluster).
# DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

# Signs the sign-in cookie. Any long random text. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty, everyone is signed out each time the server restarts.
SESSION_SECRET=

# The public address of the app, with no slash at the end, e.g.
# https://<user>-starboy.hf.space   Leave empty on the laptop.
PUBLIC_BASE_URL=

# The open models. The defaults are right for the laptop; change them only to
# try another model. WHISPER_MODEL can be "small" (better) or "base" (faster).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
WHISPER_MODEL=small

# How long Ollama keeps Gemma in memory after an answer. "30m" suits a laptop.
# On the server use -1 (forever): it has the RAM, and there are no cold starts.
OLLAMA_KEEP_ALIVE=30m

# --- Telegram bot: invites, reminders and post-game voice notes ---

# The token @BotFather gave you. Empty = the bot is off.
TELEGRAM_BOT_TOKEN=

# Leave empty: the laptop then uses "polling", and a deployed app (one with
# PUBLIC_BASE_URL set) uses "webhook". Set to "off" to switch the bot off.
TELEGRAM_MODE=

# Only for the deployed app. Any long random text (letters, digits, _ and -):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Telegram sends it with every call, which proves the call is from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Only for the deployed app. Any long random text. A free cron service calls
# /api/cron/tick?token=<this> every 10 minutes to keep reminders going.
CRON_TOKEN=
