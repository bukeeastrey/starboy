# Copy this file to ".env" (same folder) and fill it in. Never commit ".env".
# On Render, the same names go in the dashboard under Environment.

# MongoDB Atlas connection string (free M0 cluster), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Name of the database inside the cluster.
MONGODB_DB=starboy

# Optional. Set this if the health check says it can't reach the database on a
# phone hotspot or home router (their DNS often can't find an Atlas cluster).
# DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

# Signs the sign-in cookie. Any long random text. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty, everyone is signed out each time the server restarts.
SESSION_SECRET=

# The public address of the deployed app, with no slash at the end.
# LEAVE EMPTY on the laptop. Leave it out on Render too: Render tells the app
# its own address. Only set it if you host somewhere else.
PUBLIC_BASE_URL=

# --- Where the AI runs ---

# "local": Gemma through Ollama + faster-whisper on this computer (no keys).
# "cloud": Gemma 4 through the Gemini API + Whisper at Groq, both free tiers.
#          Use this on small servers (Render), or on a slow laptop.
AI_MODE=local

# Cloud mode. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Cloud mode. Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# Local mode. The defaults are right for the laptop. WHISPER_MODEL can be
# "small" (better) or "base" (faster). OLLAMA_KEEP_ALIVE is how long Gemma
# stays in memory after an answer ("30m", or -1 for always).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
WHISPER_MODEL=small
OLLAMA_KEEP_ALIVE=30m

# --- Telegram bot: invites, reminders and post-game voice notes ---

# The token @BotFather gave you. Empty = the bot is off.
TELEGRAM_BOT_TOKEN=

# Leave empty: the laptop then uses "polling", and a deployed app uses
# "webhook". Set to "off" to switch the bot off.
TELEGRAM_MODE=

# Only for the deployed app. Any long random text (letters, digits, _ and -):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Telegram sends it with every call, which proves the call is from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Only for the deployed app. Any long random text (letters, digits, _ and -).
# A free cron service calls /api/cron/tick?token=<this> every 10 minutes,
# which keeps the server awake and the reminders going.
CRON_TOKEN=
